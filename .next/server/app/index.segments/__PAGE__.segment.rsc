4:["$","$L3","temple-18",{"temple":{"id":"temple-18","name":"Sri Omkar Polychrome Sabha Mandapa & Nagara Shikhara","deity":"Lord Shiva (Omkareshwar) & Sri Hanuman","tradition":"Nagara","subType":"Pillared Sabha Mandapa with Nagara Spire & Kalashas","stoneType":"RCC Reinforced Core with Ornate Traditional Stucco Craft","location":"Central India Mandir Complex","country":"India","status":"Completed","year":"2024","height":"52 ft","area":"18,500 sq.ft","coverImage":"/images/polychrome_mandapa_shikhara.png","images":["/images/polychrome_mandapa_shikhara.png"],"description":"A magnificent open Sabha Mandapa temple with decorative multi-colored sculpted pillars, sacred Omkar sanctum arch, stepped plinth, and a soaring multi-tiered Nagara curvilinear Shikhara with dual tiered Kalasham pinnacles.","features":["Open pillared Sabha Mandapa with ornate floral colonnade","Towering curvilinear Nagara Shikhara with sacred emblems","Carved Gajapitha elephant motifs along the Mandapa cornice","Dual consecrated Kalasha finials with traditional temple flag"],"likes":640,"featured":true,"createdAt":"2026-09-23T10:20:00.000Z"}}]
5:["$","$L3","temple-14",{"temple":{"id":"temple-14","name":"Sri Mahasannidhi Granite Dravidian Vimana Spire","deity":"Lord Shiva & Maha Ganapati","tradition":"Dravida","subType":"Multi-Tier Dressed Granite Stepped Shikhara","stoneType":"Fine-Grained Grey Granite & Monolithic Finials","location":"South India / Deccan Site","country":"India","status":"Completed","year":"2024","height":"75 ft","area":"26,000 sq.ft","coverImage":"/images/granite_vimana_spire.jpg","images":["/images/granite_vimana_spire.jpg"],"description":"A magnificent multi-tiered Dravidian grey granite stone Vimana Shikhara adorned with kirtimukha architraves, sculpted niche devatas, and crowned with an intricate circular dome and kalasham finial.","features":["Pure hand-dressed grey granite stone tiers","Ornate Kirtimukha and Sala-sikhara roof motifs","Deeply sculpted devakoshta sanctum alcoves","Precision interlocking dry-joint stone engineering"],"likes":612,"featured":true,"createdAt":"2026-09-23T10:00:00.000Z"}}]
6:["$","$L3","temple-15",{"temple":{"id":"temple-15","name":"Monolithic Yali & Gaja Stambha Mandapa Pillar","deity":"Sri Veerabhadra & Vijayanagara Dwarapalakas","tradition":"Dravida","subType":"Monolithic Mythical Yali Beast & Rider Pillar","stoneType":"Single Monolithic Granite Block","location":"Karnataka / Andhra Border Project","country":"India","status":"Completed","year":"2024","height":"18 ft","area":"Mandapa Column","coverImage":"/images/yali_pillar_monolith.png","images":["/images/yali_pillar_monolith.png"],"description":"An awe-inspiring monolithic granite pillar sculpted with a rearing mythical Yali beast, royal warrior rider, and elephant pedestal (Gaja-peetha) in the classic Vijayanagara and Nayaka architectural tradition.","features":["Carved from a single solid monolithic granite block","Dynamic rearing Yali with warrior and elephant base","Deep undercut filigree relief work","Architectural load-bearing Sabha Mandapa column"],"likes":584,"featured":true,"createdAt":"2026-09-23T10:00:00.000Z"}}]
7:["$","$L3","temple-16",{"temple":{"id":"temple-16","name":"Sri Shweta Mahadwara & Guru Sanctum Archway","deity":"Sri Guru Sannidhi & Dhyana Mandir","tradition":"Dravida","subType":"Pristine White Dressed Dwarashala & Compound Arch","stoneType":"Sculpted Dressed Stone with Lime Plaster Finish","location":"Regional Ashram / Mandir Complex","country":"India","status":"Completed","year":"2024","height":"32 ft","area":"12,000 sq.ft","coverImage":"/images/white_arch_dwarashala.jpg","images":["/images/white_arch_dwarashala.jpg"],"description":"An elegant consecrated ceremonial entrance Dwarashala and compound gate featuring a central Guru niche, ornate Dravidian cornice mouldings, and deep relief floral pillar pilasters.","features":["Ornate white ceremonial temple gateway (Mahadwara)","Central deity/Guru niche with decorative Sala pediment","Deep relief floral pilaster carvings","Complete perimeter compound wall and entrance execution"],"likes":495,"featured":true,"createdAt":"2026-09-23T10:00:00.000Z"}}]
8:["$","$L3","temple-11",{"temple":{"id":"temple-11","name":"Sri Durga Mahishasuramardini Twin Gopuram Mandir","deity":"Maa Durga & Sri Lakshmi-Saraswati","tradition":"Dravida","subType":"Twin Polychrome Gopuram Spires with Carved Mandapa","stoneType":"Dressed Stone Pillars & Intricate Polychrome Stucco","location":"Pan-India Turnkey Temple Site","country":"India","status":"Completed","year":"2024","height":"68 ft","area":"32,000 sq.ft","coverImage":"/images/durga_twin_gopuram_mandapa.png","images":["/images/durga_twin_gopuram_mandapa.png"],"description":"An architectural marvel featuring twin symmetrical polychrome Gopuram towers atop an ornate stone-pillared Mukha Mandapa, crowned by a central high-relief sculpture of Maa Durga slaying the demon Mahishasura.","features":["Twin polychrome Dravidian Gopuram spires with golden Kalashams","High-relief Mahishasuramardini central arch sculpture","Dressed stone colonnade with ornamental elephant sentinels","Vivid traditional Agama temple color palette"],"likes":532,"featured":true,"createdAt":"2026-09-22T12:25:54.394Z"}}]
9:["$","$L3","temple-12",{"temple":{"id":"temple-12","name":"Sri Siddhivinayak Lotus Circular Shikhara","deity":"Lord Maha Ganesha & Navagrahas","tradition":"Vesara","subType":"Octagonal / Circular Fluted Lotus Spire","stoneType":"Stone Base with Intricate Filigree & Stucco Moulding","location":"Maharashtra Regional Consecration","country":"India","status":"Completed","year":"2023","height":"48 ft","area":"16,000 sq.ft","coverImage":"/images/lotus_ganesha_shikhara.png","images":["/images/lotus_ganesha_shikhara.png"],"description":"A uniquely crafted circular & octagonal lotus-motif Shikhara inspired by Vesara temple spires. Features 8 arched sanctified niches housing Lord Ganesha in various mudras, surrounded by multi-colored filigree floral carvings.","features":["Fluted circular lotus petal conical shikhara","8 radial devakoshta niches with sculpted deities","Fine scrollwork and traditional hand-painted floral motifs","Three-tier kalasha pinnacle with brass finial"],"likes":476,"featured":true,"createdAt":"2026-09-22T12:25:54.394Z"}}]
a:["$","$L3","temple-10",{"temple":{"id":"temple-10","name":"Sri Suvarna Rajagopuram & Basalt Sanctum","deity":"Lord Sri Venkateswara & Mahavishnu","tradition":"Dravida","subType":"Multi-Tier Golden Stepped Gopuram & Basalt Sanctum","stoneType":"Black Basalt Foundation Stone & Sculpted Lime Stucco","location":"Maharashtra / Karnataka Heritage Site","country":"India","status":"Completed","year":"2024","height":"95 ft","area":"28,000 sq.ft","coverImage":"/images/golden_yellow_gopuram.jpg","images":["/images/golden_yellow_gopuram.jpg"],"description":"A towering golden-yellow Dravidian Rajagopuram rising majestically above a polished black basalt sanctum base. Decorated with multiple tiers of sculpted devakoshta niches, dvarapalas, and culminating in a pure gold-leafed Kalasham finial.","features":["Multi-tier stepped pyramidal Dravidian tower geometry","Solid dark basalt stone plinth and sanctum masonry","Ornate devakoshta deity niches on every tier","Consecrated golden Kalasham pinnacle"],"likes":489,"featured":true,"createdAt":"2026-09-22T12:25:54.392Z"}}]
